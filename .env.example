COMPOSE_PROJECT_NAME=citycopilot
CITYCOPILOT_BIND_ADDRESS=127.0.0.1
CITYCOPILOT_TIMEZONE=Asia/Singapore

CITYCOPILOT_HTTP_PORT=8080
CITYCOPILOT_CORE_PORT=8081
CITYCOPILOT_AGENT_PORT=8082
CITYCOPILOT_MCP_PORT=8090
CITYCOPILOT_MYSQL_PORT=3307
CITYCOPILOT_AGENT_MYSQL_PORT=3308
CITYCOPILOT_COMMERCE_MYSQL_PORT=3309
CITYCOPILOT_COMMERCE_PORT=8083
CITYCOPILOT_REDIS_PORT=6380
CITYCOPILOT_ROCKETMQ_NAMESRV_PORT=9876
CITYCOPILOT_ROCKETMQ_BROKER_PORT=10911
CITYCOPILOT_ROCKETMQ_PROXY_GRPC_PORT=18081
CITYCOPILOT_ROCKETMQ_PROXY_REMOTING_PORT=18080
CITYCOPILOT_ROCKETMQ_DASHBOARD_PORT=18082
CITYCOPILOT_ELASTICSEARCH_PORT=9200

CITYCOPILOT_MYSQL_MEMORY_LIMIT=1g
CITYCOPILOT_AGENT_MYSQL_MEMORY_LIMIT=512m
CITYCOPILOT_COMMERCE_MYSQL_MEMORY_LIMIT=512m
CITYCOPILOT_COMMERCE_MEMORY_LIMIT=768m
CITYCOPILOT_REDIS_MEMORY_LIMIT=256m
CITYCOPILOT_CORE_MEMORY_LIMIT=1g
CITYCOPILOT_AGENT_MEMORY_LIMIT=768m
CITYCOPILOT_MCP_MEMORY_LIMIT=512m
CITYCOPILOT_FRONTEND_MEMORY_LIMIT=128m
CITYCOPILOT_ROCKETMQ_SERVER_VERSION=5.5.0
CITYCOPILOT_ROCKETMQ_ENABLED=true
CITYCOPILOT_ELASTICSEARCH_VERSION=8.10.4
CITYCOPILOT_ELASTICSEARCH_MEMORY_LIMIT=1g

CITYCOPILOT_DB_USERNAME=citycopilot
CITYCOPILOT_DB_PASSWORD=replace_with_a_random_password
CITYCOPILOT_MYSQL_ROOT_PASSWORD=replace_with_a_different_random_password
CITYCOPILOT_AGENT_DB_USERNAME=citycopilot_agent
CITYCOPILOT_AGENT_DB_PASSWORD=replace_with_a_random_agent_db_password
CITYCOPILOT_AGENT_MYSQL_ROOT_PASSWORD=replace_with_a_different_agent_mysql_root_password
CITYCOPILOT_COMMERCE_DB_USERNAME=citycopilot_commerce
CITYCOPILOT_COMMERCE_DB_PASSWORD=replace_with_a_random_commerce_db_password
CITYCOPILOT_COMMERCE_MYSQL_ROOT_PASSWORD=replace_with_a_different_commerce_mysql_root_password
CITYCOPILOT_REDIS_PASSWORD=replace_with_a_random_password
CITYCOPILOT_COMMERCE_REDIS_USERNAME=commerce
CITYCOPILOT_COMMERCE_REDIS_PASSWORD=replace_with_a_separate_commerce_redis_password
CITYCOPILOT_INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_token
CITYCOPILOT_INTERNAL_AGENT_TOKEN=replace_with_a_unique_agent_token
CITYCOPILOT_INTERNAL_OPS_TOKEN=replace_with_a_unique_ops_token
CITYCOPILOT_INTERNAL_OPS_READER_TOKEN=replace_with_a_unique_ops_reader_token
CITYCOPILOT_INTERNAL_OPS_EXECUTOR_TOKEN=replace_with_a_unique_ops_executor_token
CITYCOPILOT_INTERNAL_MCP_TOKEN=replace_with_a_unique_mcp_token
CITYCOPILOT_INTERNAL_COMMERCE_TOKEN=replace_with_a_unique_commerce_token

CITYCOPILOT_AI_ENABLED=false
CITYCOPILOT_AI_API_KEY=
CITYCOPILOT_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
CITYCOPILOT_AI_MODEL=qwen-plus
CITYCOPILOT_AMAP_WEB_SERVICE_KEY=
CITYCOPILOT_GEO_LOCAL_DISCOVERY_MODE=redis
CITYCOPILOT_GEO_REDIS_CANDIDATE_MULTIPLIER=3
CITYCOPILOT_GEO_REDIS_MAX_CANDIDATES=500
CITYCOPILOT_GEO_RECONCILE_ENABLED=true
CITYCOPILOT_GEO_RECONCILE_INTERVAL_MS=60000
CITYCOPILOT_SEARCH_ENABLED=false
CITYCOPILOT_SEARCH_MODE=mysql
CITYCOPILOT_SEARCH_INDEX_ALIAS=citycopilot-shop-search
CITYCOPILOT_SEARCH_MAX_PAGE_SIZE=500
CITYCOPILOT_SEARCH_RECONCILE_INTERVAL_MS=60000

VITE_DEFAULT_CITY=杭州
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
