{
  "title": "CityCopilot Agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"city-copilot\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(citycopilot_tool_call_duration_seconds_sum{application=\"city-copilot\"}[5m])) by (tool) / sum(rate(citycopilot_tool_call_duration_seconds_count{application=\"city-copilot\"}[5m])) by (tool)",
          "legendFormat": "{{tool}} avg"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool call rate",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(citycopilot_tool_call_count_total{application=\"city-copilot\"}[5m])) by (tool, outcome)",
          "legendFormat": "{{tool}} {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM call rate",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(citycopilot_llm_call_count_total{application=\"city-copilot\"}[5m])) by (operation, outcome)",
          "legendFormat": "{{operation}} {{outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "JVM memory used",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"city-copilot\"})",
          "legendFormat": "used"
        }
      ]
    }
  ]
}
