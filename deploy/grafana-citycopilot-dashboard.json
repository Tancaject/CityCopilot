{
  "title": "CityCopilot Agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"city-copilot\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool latency",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(method_timed_seconds_bucket{application=\"city-copilot\"}[5m])) by (le, method))",
          "legendFormat": "{{method}} p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "JVM memory used",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"city-copilot\"})",
          "legendFormat": "used"
        }
      ]
    }
  ]
}
