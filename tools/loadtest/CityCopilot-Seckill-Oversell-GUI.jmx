          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="分类 ACCEPTED / STOCK_EXHAUSTED / UNEXPECTED" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString()
def httpCode = prev.getResponseCode()
def parsed = [:]
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception ignored) {
    // The response is classified as unexpected below.
}

boolean accepted = httpCode == &apos;200&apos; &amp;&amp; parsed.success == true &amp;&amp; parsed.data != null
boolean exhausted = (httpCode == &apos;200&apos; || httpCode == &apos;409&apos;)
    &amp;&amp; parsed.success == false
    &amp;&amp; parsed.code == &apos;SECKILL_STOCK_NOT_ENOUGH&apos;

if (accepted) {
    props.get(&apos;citycopilot.oversell.accepted&apos;).incrementAndGet()
    prev.setSampleLabel(&apos;POST 秒杀下单 - ACCEPTED&apos;)
    prev.setSuccessful(true)
} else if (exhausted) {
    props.get(&apos;citycopilot.oversell.exhausted&apos;).incrementAndGet()
    prev.setSampleLabel(&apos;POST 秒杀下单 - STOCK_EXHAUSTED（预期）&apos;)
    prev.setSuccessful(true)
    prev.setResponseMessage(&apos;Expected business rejection: stock exhausted&apos;)
} else {
    props.get(&apos;citycopilot.oversell.unexpected&apos;).incrementAndGet()
    prev.setSampleLabel(&apos;POST 秒杀下单 - UNEXPECTED&apos;)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Unexpected seckill response: HTTP ${httpCode}; code=${parsed.code}; ${prev.getResponseMessage()}&quot;)
}
            </stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
