<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="CityCopilot 秒杀超卖正确性测试（GUI）">
      <stringProp name="TestPlan.comments">正确性场景：默认准备 20000 个唯一用户、5000 库存，以 200 并发和 5 秒升压发出 20000 个请求。预期恰好 5000 个 ACCEPTED、15000 个 STOCK_EXHAUSTED；库存不足属于正常业务结果，不计为 JMeter 错误。HTTP 请求结束后，③ 最终核验会等待异步订单落库；单实例消费者可能需要数分钟，最多等待 10 分钟，随后校验无超卖、无重复订单、MySQL/Redis 库存一致。</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="测试参数">
        <collectionProp name="Arguments.arguments">
          <elementProp name="users" elementType="Argument">
            <stringProp name="Argument.name">users</stringProp>
            <stringProp name="Argument.value">${__P(users,20000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="stock" elementType="Argument">
            <stringProp name="Argument.name">stock</stringProp>
            <stringProp name="Argument.value">${__P(stock,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(threads,200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ramp" elementType="Argument">
            <stringProp name="Argument.name">ramp</stringProp>
            <stringProp name="Argument.value">${__P(ramp,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="drain_timeout" elementType="Argument">
            <stringProp name="Argument.name">drain_timeout</stringProp>
            <stringProp name="Argument.value">${__P(drain_timeout,600)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="python" elementType="Argument">
            <stringProp name="Argument.name">python</stringProp>
            <stringProp name="Argument.value">${__P(python,C:/Users/Orion/AppData/Local/Programs/Python/Python312/python.exe)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="root" elementType="Argument">
            <stringProp name="Argument.name">root</stringProp>
            <stringProp name="Argument.value">${__P(root,D:/programming/CityCopilot)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="tokens" elementType="Argument">
            <stringProp name="Argument.name">tokens</stringProp>
            <stringProp name="Argument.value">${__P(tokens,D:/programming/CityCopilot/tools/loadtest/commerce-tokens.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
