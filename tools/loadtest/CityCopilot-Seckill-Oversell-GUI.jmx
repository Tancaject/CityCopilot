        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="校验参数并初始化业务计数器" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import groovy.json.JsonOutput
import java.util.concurrent.atomic.AtomicInteger

int users = Integer.parseInt(vars.get(&apos;users&apos;))
int stock = Integer.parseInt(vars.get(&apos;stock&apos;))
boolean valid = users &gt; stock &amp;&amp; stock &gt; 0

props.put(&apos;citycopilot.oversell.accepted&apos;, new AtomicInteger(0))
props.put(&apos;citycopilot.oversell.exhausted&apos;, new AtomicInteger(0))
props.put(&apos;citycopilot.oversell.unexpected&apos;, new AtomicInteger(0))

def report = [
    users: users,
    stock: stock,
    expectedAccepted: stock,
    expectedStockExhausted: users - stock,
    valid: valid
]
SampleResult.setResponseData(JsonOutput.prettyPrint(JsonOutput.toJson(report)), &apos;UTF-8&apos;)
SampleResult.setResponseCode(valid ? &apos;200&apos; : &apos;400&apos;)
SampleResult.setResponseMessage(valid
    ? &apos;Oversell parameters initialized&apos;
    : &apos;Invalid oversell parameters: users must be greater than stock and stock must be positive&apos;)
SampleResult.setSuccessful(valid)
          </stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
