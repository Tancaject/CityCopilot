      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="核验 HTTP 业务结果数量" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import groovy.json.JsonOutput

int users = Integer.parseInt(vars.get(&apos;users&apos;))
int stock = Integer.parseInt(vars.get(&apos;stock&apos;))
def acceptedCounter = props.get(&apos;citycopilot.oversell.accepted&apos;)
def exhaustedCounter = props.get(&apos;citycopilot.oversell.exhausted&apos;)
def unexpectedCounter = props.get(&apos;citycopilot.oversell.unexpected&apos;)
int accepted = acceptedCounter == null ? -1 : acceptedCounter.get()
int exhausted = exhaustedCounter == null ? -1 : exhaustedCounter.get()
int unexpected = unexpectedCounter == null ? -1 : unexpectedCounter.get()
int expectedExhausted = users - stock
boolean valid = accepted == stock &amp;&amp; exhausted == expectedExhausted &amp;&amp; unexpected == 0

def report = [
    requests: users,
    expectedAccepted: stock,
    actualAccepted: accepted,
    expectedStockExhausted: expectedExhausted,
    actualStockExhausted: exhausted,
    unexpected: unexpected,
    valid: valid
]
SampleResult.setResponseData(JsonOutput.prettyPrint(JsonOutput.toJson(report)), &apos;UTF-8&apos;)
SampleResult.setResponseCode(valid ? &apos;200&apos; : &apos;500&apos;)
SampleResult.setResponseMessage(valid
    ? &apos;HTTP business outcomes match expected counts&apos;
    : &apos;HTTP business outcome counts do not match the configured stock and users&apos;)
SampleResult.setSuccessful(valid)
          </stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <SystemSampler guiclass="SystemSamplerGui" testclass="SystemSampler" testname="等待 Stream 清空并核验订单/库存（可能数分钟，最多 10 分钟）" enabled="true">
          <boolProp name="SystemSampler.checkReturnCode">true</boolProp>
          <stringProp name="SystemSampler.expectedReturnCode">0</stringProp>
          <stringProp name="SystemSampler.command">${python}</stringProp>
          <elementProp name="SystemSampler.arguments" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">${root}/tools/loadtest/seed_commerce_loadtest.py</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">--verify</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">--wait-for-drain</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">--stock</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">${stock}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
              <elementProp name="" elementType="Argument">
                <stringProp name="Argument.name"></stringProp>
                <stringProp name="Argument.value">--users</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
